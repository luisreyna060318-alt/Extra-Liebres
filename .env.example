# Variables de docker-compose.yml. Copia este archivo a ".env" (en esta misma
# carpeta) y cambia la contraseña. El archivo .env no se versiona.

POSTGRES_USER=extraliebres
# Usa solo letras, numeros, "-" y "_" (va dentro de la URL de conexion).
# Si ya tienes el volumen "pgdata" creado, la contraseña real es la que tenia
# cuando se creo (antes era "extraliebres"): pon esa o cambiala con
# ALTER USER extraliebres WITH PASSWORD '...'; dentro de la base.
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=extraliebresdb

# IP y puerto donde se publica el frontend. 127.0.0.1 = solo esta maquina.
# La aplicacion NO tiene autenticacion: no uses 0.0.0.0 fuera de una red
# controlada.
FRONTEND_IP=127.0.0.1
FRONTEND_PORT=5173

# Respaldos automaticos (servicio "respaldos", carpeta ./respaldos).
RESPALDO_INTERVALO_HORAS=24
RESPALDO_RETENCION_DIAS=14
