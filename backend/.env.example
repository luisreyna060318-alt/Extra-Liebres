# Copia este archivo a ".env" y ajusta los valores para tu entorno local.

# Cadena de conexion a PostgreSQL (formato que espera Prisma)
DATABASE_URL="postgresql://extraliebres:extraliebres@localhost:5432/extraliebresdb?schema=public"

# Puerto en el que escucha la API
PORT=4000

# Origen permitido para CORS (URL del frontend Vite)
CORS_ORIGIN="http://localhost:5173"

# Entorno de ejecucion: development | production | test
NODE_ENV=development
