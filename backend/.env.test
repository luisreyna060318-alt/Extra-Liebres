# Usado por "npm test" cuando se corre directamente en el host (no dentro de
# un contenedor de Docker). Requiere una base de datos separada
# "extraliebresdb_test" con las migraciones aplicadas — nunca apunta a la
# base de datos real para no arriesgar los datos importados.
DATABASE_URL="postgresql://extraliebres:extraliebres@localhost:5432/extraliebresdb_test?schema=public"
PORT=4001
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=test
